  <!-- ==================================================================
       PincOpen 그리퍼 (순정 moving_jaw_so101_v1 교체)

       출처 : pollen-robotics/PincOpen  PR #6 (MuJoCo Simulation Support)
              메시 mujoco/assets/*.stl → DAE 변환, 관절값 mujoco/eef.xml
       라이선스 : CC BY-SA 4.0 (Pollen Robotics)
       단위 : 미터 (원본이 이미 m → 스케일 변환 없음)

       ⚠️ 임시값 (실물 확인 후 확정할 것)
         1) pincopen_mount origin — Interface_ARM100 어댑터 두께 미실측.
            Unity 인스펙터(PincOpenCoupling)에서 눈으로 맞춘 뒤 여기에 굽기.
         2) limit ±1.25 rad — 손가락 커플링 배율이 ×0.5(ROS2)인지
            ×1.0(MJCF)인지 미확정이라 둘 다 수용하도록 넓게 잡음.
            실물 대조 후 좁힐 것.
         3) mass/inertia — MJCF 원본이 명백한 임시값이라 쓰지 않고
            형상 크기에 맞춰 대략 지정. 동역학 계산에 쓰지 말 것.

       ※ 이 파일의 관절각 = 손가락 각도.  모터(ID 6) 각도와 다름.
         PINCOPEN.md 기준 모터 140° ≈ 손가락 44°.
       ================================================================== -->

  <!-- ===== 손목 → Interface_ARM100 어댑터 =====
       ✅ 2026-08-01 확정. 사용자 육안 확인 + 렌더링 검증 완료.

       유도 근거 (추측 아님):
         · 순정 TCP(gripper_frame_joint)가 z=-0.0981 → 공구 방향은 gripper_link 의 -Z
         · PincOpen 은 +X 가 손가락 방향
         · +X 를 -Z 로 보내는 회전 = Y축 +90°  → rpy="0 1.5708 0"
         · 어댑터 두께 8.117mm 만큼 뒤로 물림   → xyz z=-0.008117

       ⚙️ 관절 리밋 (2026-08-01 확정)
         모든 PincOpen 관절 = lower="-0.8465" upper="0" (-48.5° ~ 0°)
           · 0.8465 rad = 48.5° : 메시 정점 실측. -48.9°에서 좌우 패드가 맞닿음
           · 0 = 열림(개구부 66mm), -0.8465 = 닫힘(맞닿음). ROS2 의 1.22 rad 를  쓰면 22mm 파고듦 — 기준 0점이 다름
         ⚠️ 이 값은 **손가락 각도**다. 모터 각도가 아니다.
            모터: 0°(닫힘) ~ -140°(열림), 펌웨어 하드리밋 -147°

       검증 결과: 손목↔어댑터 빈틈 0.0mm (접촉), 좌우 대칭 정렬 확인.

       ⚠️ 이 값이 단일 진실 공급원이다.
          PincOpenCoupling.applyMountOffset 을 켜면 이 값이 무시되므로 꺼둘 것. -->
  <joint name="pincopen_mount" type="fixed">
    <origin xyz="0 0 -0.008117" rpy="0 1.5708 0"/>
    <parent link="gripper_link"/>
    <child link="pincopen_adapter_link"/>
  </joint>

  <!-- Interface_ARM100 — SO-ARM101 ↔ PincOpen 결합 어댑터
       출처 : pollen-robotics/PincOpen  cad/stl/Interface_ARM100.stl (CC BY-SA 4.0)
       실측 : 두께 8.117mm × 51mm × 24mm
       ✅ 메시를 mm→m 변환하면서 x 를 +53.492mm 평행이동해
          앞면이 정확히 x=0 (= PincOpen base 뒷면) 에 오도록 미리 맞춰뒀다.
          따라서 아래 visual origin 과 base 조인트 origin 은 둘 다 0 이 맞다. -->
  <link name="pincopen_adapter_link">
    <inertial>
      <origin xyz="-0.004 0 0" rpy="0 0 0"/>
      <mass value="0.015"/>
      <inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/PincOpen/visual/Interface_ARM100.dae"/>
      </geometry>
      <material name="3d_printed"/>
    </visual>
  </link>

  <!-- 어댑터 앞면 ↔ PincOpen 본체 뒷면 (기하학적으로 확정된 관계, 조정 불필요) -->
  <joint name="pincopen_base_joint" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <parent link="pincopen_adapter_link"/>
    <child link="pincopen_base_link"/>
  </joint>

  <link name="pincopen_base_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.08"/>
      <inertia ixx="1e-4" ixy="0" ixz="0" iyy="1e-4" iyz="0" izz="1e-4"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/PincOpen/visual/base.dae"/>
      </geometry>
      <material name="3d_printed"/>
    </visual>
  </link>

  <!-- ===== 왼쪽 (구동축 — 모터 ID 6 이 여기에 대응) ===== -->
  <joint name="gripper" type="revolute">
    <origin xyz="0.053492 0.0325 -0.005" rpy="0 0 0"/>
    <parent link="pincopen_base_link"/>
    <child link="pincopen_left_proximal_link"/>
    <axis xyz="0 0 1"/>
    <limit effort="10" velocity="10" lower="-0.8465" upper="0"/>
  </joint>

  <link name="pincopen_left_proximal_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.02"/>
      <inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/PincOpen/visual/left_proximal.dae"/>
      </geometry>
      <material name="3d_printed"/>
    </visual>
  </link>

  <joint name="pincopen_left_distal_joint" type="revolute">
    <origin xyz="0.037848 0.012944 -0.001" rpy="0 0 0"/>
    <parent link="pincopen_left_proximal_link"/>
    <child link="pincopen_left_distal_link"/>
    <axis xyz="0 0 1"/>
    <limit effort="10" velocity="10" lower="-0.8465" upper="0"/>
  </joint>

  <link name="pincopen_left_distal_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.01"/>
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
